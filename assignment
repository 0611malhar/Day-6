# Function to check odd or even
def check(num):
    if num % 2 == 0:
        print(num, "is Even")
    else:
        print(num, "is Odd")


# Function to check divisibility by 3
def divisible(num):
    if num % 3 == 0:
        print(num, "is divisible by 3")
    else:
        print(num, "is not divisible by 3")

