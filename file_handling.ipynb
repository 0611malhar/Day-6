    "'''\n",
    "7. Write a program to find out the line number where python is present from ques 6.\n",
    "'''\n",
    "f = open(\"log_file.txt\")\n",
    "c = 0\n",
    "line = f.readline()\n",
    "while line != \"\":\n",
    "    if \"python\" in line.lower():\n",
    "        c += 1\n",
    "    line = f.readline()\n",
    "f.close()\n",
    "print(\"number of lines with the word 'python' is:\", c)"
