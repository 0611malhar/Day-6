    "'''\n",
    "4. A file contains a word \"Donkey\" multiple times. You need to write a program which\n",
    "replace this word with ##### by updating the same file.\n",
    "'''\n",
    "# 4.\n",
    "f = open(\"abd.txt\")\n",
    "d = f.read().split()\n",
    "f.close\n",
    "for i in range(len(d)):\n",
    "    if d[i].lower()==\"donkey\":\n",
    "        d[i]=\"######\"\n",
    "d=\"\".join(d)\n",
    "f = open(\"abd.txt\",\"w\")\n",
    "f.seek(0)\n",
    "f.write(d)\n",
    "f.close\n",
    "f = open(\"abd.txt\")\n",
    "f.seek(0)\n",
    "print(f.read())\n",
    "f.close"
   ]
